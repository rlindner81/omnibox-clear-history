{
  "manifest_version": 3,
  "homepage_url": "https://github.com/rlindner81/omnibox-clear-history",
  "name": "Omnibox Clear History",
  "description": "Clear Omnibox Google search history suggestions",
  "version": "1.6",
  "permissions": ["history", "storage", "alarms"],
  "action": {},
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "clear-history.js"
  },
  "icons": {
    "48": "icon_48.png",
    "128": "icon_128.png"
  }
}
